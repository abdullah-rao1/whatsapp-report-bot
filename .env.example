# ---- Supabase (same project the tracker app uses) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the SERVICE ROLE key here (Project Settings -> API), NOT the anon key.
# This key is powerful and must never be put in the frontend HTML — it only
# ever lives on this backend server.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Groq (free Llama API) ----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Security ----
# A password you invent yourself. The tracker app's admin will paste this
# into Settings so it can call this backend. Keep it secret.
ADMIN_TOKEN=choose-a-long-random-string

# ---- Server ----
PORT=3000
